  "description": "Локальна програма для пошуку сайтів і публічних контактів",
  "main": "main.js",
  "license": "MIT",
  "scripts": {"start": "electron .", "dist": "electron-builder --win portable"},
  "devDependencies": {"electron": "^35.0.0", "electron-builder": "^26.0.12"},
